# D&D Beyond session cookie (the long-lived CobaltSession "remember me" cookie).
# This server NEVER opens a browser — supply the cookie here, or write
# {"cookie":"<value>"} to <data dir>/ddb-cobalt.json (see DDB_DATA_DIR). Copy the value
# from DevTools on a logged-in dndbeyond.com tab, or let a harvester such as the
# dm-whisper gem write the file. README "Getting the cookie" has the steps.
#DDB_COBALT=

# Default DDB campaign/game id for ddb_list_campaign_characters / start_ddb_roll_pump
# when the caller doesn't pass one.
#DDB_CAMPAIGN_ID=

# Set to "enabled" to register the WRITE tools (ddb_set_hp, ddb_apply_condition,
# ddb_remove_condition). Unset/anything else = reads only. These effect real changes
# on D&D Beyond character sheets.
#DDB_WRITES=enabled

# Directory holding ddb-cobalt.json and the monster-config cache. If a harvester such as
# the dm-whisper gem writes the cookie, point this at its directory (roll20-dm-mcp's
# ROLL20_DATA_DIR) so the cookie is shared. Default: ./data, relative to the working
# directory — use an absolute path, since MCP clients pick the cwd.
#DDB_DATA_DIR=

# HTTP entry point (npm run serve) — stdio (npm start) ignores these.
#DDB_HTTP_PORT=39210
#DDB_HTTP_HOST=127.0.0.1
# Bearer token for the HTTP transport; auto-generated into .env on first run if unset.
#DDB_MCP_TOKEN=
