# D&D Beyond session cookie (the long-lived CobaltSession "remember me" cookie).
# This server NEVER opens a browser — supply the cookie here, or let the gem write
# it to <data dir>/ddb-cobalt.json (see DDB_DATA_DIR).
#DDB_COBALT=

# Default DDB campaign/game id for ddb_list_campaign_characters / start_ddb_roll_pump
# when the caller doesn't pass one.
#DDB_CAMPAIGN_ID=

# Set to "enabled" to register the WRITE tools (ddb_set_hp, ddb_apply_condition,
# ddb_remove_condition). Unset/anything else = reads only. These effect real changes
# on D&D Beyond character sheets.
#DDB_WRITES=enabled

# Directory holding ddb-cobalt.json and the monster-config cache. Point it at the
# same directory the dm-whisper gem uses (roll20-dm-mcp's ROLL20_DATA_DIR) so the
# harvested cookie is shared. Default: ./data
#DDB_DATA_DIR=

# HTTP entry point (npm run serve) — stdio (npm start) ignores these.
#DDB_HTTP_PORT=39210
#DDB_HTTP_HOST=127.0.0.1
# Bearer token for the HTTP transport; auto-generated into .env on first run if unset.
#DDB_MCP_TOKEN=
